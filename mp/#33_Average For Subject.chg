subjects:[4] = ['Math', 'Science', 'English', 'Filipino'];

for i in range(4):
    current_sub = subjects[i];
    show 'Subject: ';
    show current_sub;
    show '\n';
    
    total_score = 0;
    
    for q in range(1, 6):
        is_input_valid = false;
        
        while is_input_valid == false:
            show 'Enter score for Quiz ';
            show q;
            show ': ';
            
            score_in = read;
            
            score = int(score_in);
            
            if score < 0:
                show 'Invalid input: Negative numbers are not allowed.\n';
            else:
                total_score = total_score + score;
                is_input_valid = true;
            close
        close
    close
    
    average = total_score / 5;
    show 'Average for ';
    show current_sub;
    show ': ';
    show average;
    show '\n\n';
close