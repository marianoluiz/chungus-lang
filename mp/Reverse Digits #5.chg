###
  PROGRAM 5: REVERSE OF DIGITS
  a) Compute & Display the sum of digits  (e.g. 156 -> 1+5+6 = 12)
  b) Display the reverse of the digit     (e.g. 156 -> 651)

  Uses functions with parameter passing and return values.
  NOTE: Chungus show only accepts a variable or a str_literal.
###

### ============================================================
    SUM OF DIGITS
    Accepts an integer n (positive) and returns the sum of
    all its individual digits.
    Example: sum_of_digits(156) -> 12
   ============================================================ ###
fn sum_of_digits(n):
    total = 0;
    temp = n;
    while temp > 0:
        digit = temp % 10;
        total = total + digit;
        temp = temp // 10;
    close
    ret total;
close

### ============================================================
    REVERSE OF DIGITS
    Accepts an integer n (positive) and returns the number
    formed by reversing its digits.
    Example: reverse_digits(156) -> 651
   ============================================================ ###
fn reverse_digits(n):
    rev = 0;
    temp = n;
    while temp > 0:
        digit = temp % 10;
        rev = rev * 10 + digit;
        temp = temp // 10;
    close
    ret rev;
close

### ============================================================
   MAIN PROGRAM
   ============================================================ ###
show '=== REVERSE OF DIGITS ===\n';
show 'Enter a positive integer: ';
user_input = read;
num = int(user_input);

digit_sum = sum_of_digits(num);
reversed  = reverse_digits(num);

show '\nNumber entered : ';
show user_input;
show '\n';

show 'Sum of digits  : ';
show digit_sum;
show '\n';

show 'Reversed digits: ';
show reversed;
show '\n';
