fn gcd(a, b):
    res = a;
    if b != 0:
        rem = a % b;
        res = gcd(b, rem);
    close
    ret res;
close

fn lcm(a, b):
    ans = 0;
    if a == 0:
        ans = 0;
    elif b == 0:
        ans = 0;
    else:
        div = gcd(a, b);
        prod = a * b;
        ans = prod // div;
    close
    ret ans;
close

show '--- LCM (Recursion) ---\n';
show 'Enter first number:\n';
in1 = read;

show 'Enter second number:\n';
in2 = read;

if in1 == '':
    show 'Error: First input is empty.\n';
elif in2 == '':
    show 'Error: Second input is empty.\n';
else:
    n1 = int(in1);
    n2 = int(in2);

    if n1 < 0:
        show 'Error: Negative numbers are not supported.\n';
    elif n2 < 0:
        show 'Error: Negative numbers are not supported.\n';
    else:
        lcm_res = lcm(n1, n2);
        show 'The LCM is:\n';
        show lcm_res;
        show '\n';
    close
close