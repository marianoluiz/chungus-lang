fn count_digits(n):
    res = 0;
    if n < 10:
        res = 1;
    else:
        res = 1 + count_digits(n // 10);
    close
    ret res;
close

app_open = true;

while app_open:
    show '\n > Input a positive number (or type EXIT to close): ';
    
    val = read;
    t_val = type(val);
    
    is_int = compare(t_val, 'int');
    is_str = compare(t_val, 'str');

    if is_int:
        if val < 0:
            show '\n [X] Error: Invalid Input. Number cannot be negative.\n';
        else:
            num = int(val);
            ans = count_digits(num);
            
            show '\n  [ SUCCESS ]\n';
            show '  > The number of digits is : ';
            show ans;
            show '\n';
        close
        
    elif is_str:
        is_exit = compare(val, 'EXIT');
        
        if is_exit:
            show '\n Closing Digit Counter. Goodbye!\n';
            app_open = false;
        else:
            len_val = length(val);
            if len_val == 0:
                show '\n [X] Error: Input cannot be blank.\n';
            else:
                show '\n [X] Error: Invalid Input. Please enter numbers only.\n';
            close
        close
        
    else:
        show '\n [X] Error: Unrecognized input format.\n';
    close
close