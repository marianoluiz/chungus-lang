fn gcd(a, b, depth):
    result = 0;
    if depth > 100:
        result = 0 - 1;
    elif b == 0:
        result = a;
    elif b != 0:
        rem = a % b;
        result = gcd(b, rem, depth + 1);
    close
    ret result;
close

fn abs_val(n):
    res = n;
    if n < 0:
        res = 0 - n;
    close
    ret res;
close

app_open = true;

while app_open:
    show '\n------------------------------------\n';
    show '        RECURSIVE GCD FINDER        \n';
    show '------------------------------------\n';
    show '  [1] Find GCD of two numbers\n';
    show '  [2] Close Tool\n';
    show ' --> Select option (1-2): ';

    opt = read;
    t_opt = type(opt);
    is_opt_int = compare(t_opt, 'int');
    is_opt_str = compare(t_opt, 'str');

    if is_opt_int:
        if opt == 1:
            
            n1_valid = false;
            n1 = 0;
            while !n1_valid:
                show '\n > Enter the first integer: ';
                val1 = read;
                t_val1 = type(val1);
                is_int1 = compare(t_val1, 'int');
                is_str1 = compare(t_val1, 'str');

                if is_int1:
                    n1 = val1;
                    n1_valid = true;
                elif is_str1:
                    len_v1 = length(val1);
                    if len_v1 == 0:
                        show ' [X] Error: Input cannot be blank.\n';
                    elif len_v1 > 0:
                        show ' [X] Error: Letters are not allowed.\n';
                    close
                elif !is_int1:
                    show ' [X] Error: Unrecognized input format.\n';
                close
            close

            n2_valid = false;
            n2 = 0;
            while !n2_valid:
                show ' > Enter the second integer: ';
                val2 = read;
                t_val2 = type(val2);
                is_int2 = compare(t_val2, 'int');
                is_str2 = compare(t_val2, 'str');

                if is_int2:
                    n2 = val2;
                    n2_valid = true;
                elif is_str2:
                    len_v2 = length(val2);
                    if len_v2 == 0:
                        show ' [X] Error: Input cannot be blank.\n';
                    elif len_v2 > 0:
                        show ' [X] Error: Letters are not allowed.\n';
                    close
                elif !is_int2:
                    show ' [X] Error: Unrecognized input format.\n';
                close
            close

            a = abs_val(n1);
            b = abs_val(n2);
            
            is_zero = false;
            if a == 0:
                if b == 0:
                    is_zero = true;
                close
            close
            
            if is_zero:
                show '\n [X] Error: GCD is undefined for (0, 0).\n';
            elif !is_zero:
                g = gcd(a, b, 0);
                
                if g < 0:
                    show '\n [X] Error: Recursion limit exceeded.\n';
                elif g >= 0:
                    show '\n  [ RESULTS ]\n';
                    show '  > First Number  : '; show n1; show '\n';
                    show '  > Second Number : '; show n2; show '\n';
                    show '  > GCD           : '; show g; show '\n';
                close
            close

            waiting = true;
            while waiting:
                show '\n --> [ Enter 1 to return to Menu ] : ';
                wait_opt = read;
                t_wait = type(wait_opt);
                is_wait_int = compare(t_wait, 'int');
                is_w_str = compare(t_wait, 'str');

                if is_wait_int:
                    if wait_opt == 1:
                        waiting = false;
                    elif wait_opt != 1:
                        show '\n [X] Error: Please enter exactly 1 to return.\n';
                    close
                elif is_w_str:
                    len_w = length(wait_opt);
                    if len_w == 0:
                        show '\n [X] Error: Input cannot be blank.\n';
                    elif len_w > 0:
                        show '\n [X] Error: Letters are not allowed.\n';
                    close
                elif !is_wait_int:
                    show '\n [X] Error: Invalid format.\n';
                close
            close

        elif opt == 2:
            show '\n Closing Tool. Goodbye!\n';
            app_open = false;
        elif opt > 2:
            show '\n [X] Error: Invalid selection. Please enter 1 or 2.\n';
        elif opt < 1:
            show '\n [X] Error: Invalid selection. Please enter 1 or 2.\n';
        close

    elif is_opt_str:
        len_opt = length(opt);
        if len_opt == 0:
            show '\n [X] Error: Menu input cannot be blank.\n';
        elif len_opt > 0:
            show '\n [X] Error: Please enter a number, not text.\n';
        close
    elif !is_opt_int:
        show '\n [X] Error: Invalid input type.\n';
    close
close