fn getMaxRecursive(index, total, currentMax):
    res = currentMax;
    
    if (index < total):
        show 'Element ';
        show index;
        show ': ';
        contender = read;
        
        # Validation: If it's a number, it should be > some extreme value or 0
        # If user types 'abc', your backend sees it as 1.0 (True)
        newMax = currentMax;
        if (contender > currentMax):
            newMax = contender;
        close
        
        nextIdx = index + 1;
        res = getMaxRecursive(nextIdx, total, newMax);
    close
    
    ret res;
close

fn startFindMax():
    keepFinding = true;
    
    while (keepFinding == true):
        show 'Enter number of elements: ';
        n = read;
        
        # Error Handling: Ensure n is a valid positive number
        isValidN = false;
        if (n > 0):
            isValidN = true;
        close
        
        if (isValidN == false):
            show 'ERROR: Please enter a number greater than 0.\n';
        else:
            show 'Element 0: ';
            first = read;

            finalMax = getMaxRecursive(1, n, first);
            
            show '\nThe largest element is: ';
            show finalMax;
            show '\n';
        close
        
        # Restart Logic
        isValidChoice = false;
        while (isValidChoice == false):
            show 'Find another max? (yes/no): ';
            choice = read;
            if (compare(choice, 'yes')): 
                isValidChoice = true; 
            close
            if (compare(choice, 'no')): 
                isValidChoice = true; 
                keepFinding = false; 
            close
            if (isValidChoice == false):
                show 'Please type "yes" or "no".\n';
            close
        close
    close
    
    ret 0;
close

# Start the application
startFindMax();
show '\nENDING PROGRAM\n';