sum = 0;
input_val = 1;

while input_val != 0:
    show 'Enter an Positive integer (0 to stop): ';
    input_val = read;
    
    if input_val < 0:
        show 'Input must be POSITIVE INTEGER!\n';
    else:
        sum = sum + input_val;
    close
close

show 'The sum of all positive integers is: ';
show sum;
show '\n';