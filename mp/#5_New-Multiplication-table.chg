show 'Enter number of rows: ';
row = read;
row = int(row);
show 'Enter number of columns: ';
col = read;
col = int(col);

row_limit = row + 1;
col_limit = col + 1;

for i in range(1, row_limit):
    for j in range(1, col_limit):
        result = i * j;
        show result;
        show ' ';
    close
    show '\n';
close