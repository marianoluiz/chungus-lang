show 'MAIN MENU\n';

validChoice = 0;
choice = 0; 

while (validChoice == 0):
    show '[1] Phase 1: Text Input Mode\n';
    show '[2] Phase 2: Number Input Mode\n';
    show 'Choose an option (1 or 2): ';
    
    choice = read;
    choice = int(choice);

    if (choice <= 0):
        show '\n[!] Invalid input. Please enter 1 or 2 only.\n\n';
    elif (choice >= 3):
        show '\n[!] Invalid input. Please enter 1 or 2 only.\n\n';
    else:
        validChoice = 1;
    close
close

if (choice == 1):
    show '\n[PHASE 1: TEXT INPUT MODE]\n';
    stop1 = 0;
    while (stop1 == 0):
        show 'Input a character: ';
        val1 = read;
        
        if (compare(type(val1), 'int') == 1):
            show 'Number detected. Stopping Mode 1.\n';
            stop1 = 1;
        elif (compare(type(val1), 'float') == 1):
            show 'Number detected. Stopping Mode 1.\n';
            stop1 = 1;
        close
    close

elif (choice == 2):
    show '\n[PHASE 2: NUMBER INPUT MODE]\n';
    stop2 = 0;
    while (stop2 == 0):
        show 'Input a number: ';
        val2 = read;
        
        if (compare(type(val2), 'str') == 1):
            show 'Character detected. Stopping Mode 2.\n';
            stop2 = 1;
        close
    close
close


show '\nPROGRAM TERMINATED\n';