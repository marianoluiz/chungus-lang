show 'Enter a number N to find the sum of cubes from 1 to N: ';
n = read;
n = int(n);

if n < 1:
    show 'Error: N must be a positive integer.';
else:
    sum = 0;
    limit = n + 1;

    for i in range(1, limit):
        cubed = i ** 3;
        sum = sum + cubed;
    close

    show 'Sum of cubes from 1 to N: ';
    show sum;
close