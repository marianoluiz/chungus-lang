

show 'Enter a number to check: ';
user_in = read;

num = int(user_in);

if num <= 0:
    show 'Error: Please enter a positive integer.';
else:
    sum = 0;
   
    for i in range(1, num):
        rem = num % i;
        if rem == 0:
            sum = sum + i;
        close
    close

    if sum == num:
        show num;
        show ' is a Perfect Number.';
    else:
        show num;
        show ' is NOT a Perfect Number.';
    close
close