fn getMaxRecursive(index, total, currentMax):
    res = currentMax;
    
    if (index < total):
        show 'element ';
        show index;
        show ': ';
        contender = read;
        
        newMax = currentMax;
        if (contender > currentMax):
            newMax = contender;
        close
        
        nextIdx = index + 1;
        res = getMaxRecursive(nextIdx, total, newMax);
    close
    
    ret res;
close

fn startFindMax():
    show 'enter number of elements: ';
    n = read;
    
    if (n > 0):
        show 'element 0: ';
        first = read;

        finalMax = getMaxRecursive(1, n, first);
        
        show '\nThe largest element is: ';
        show finalMax;
    close
    
    ret 0;
close


startFindMax();
show '\n'; 