fn printNaturals(current, max):
    if (current <= max):
        show current;
        show ' ';         
        nextNum = current + 1;
        printNaturals(nextNum, max);
    close
close

validInput = 0;
n = 0; 
while (validInput == 0):
    show 'input number : ';
    n = read;
    if (n > 0):
        validInput = 1; 
    else:
        show 'Invalid input! Natural numbers must be 1 or greater.';
        show '\n';
    close
close

show 'The Natural Numbers are: ';
printNaturals(1, n);
show '\n';