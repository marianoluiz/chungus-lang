show 'Enter a positive integer: \n';
input_str = read;
num = int(input_str);

if num < 0:
    show 'Factorial of a negative number does not exist.\n';
close

if num >= 0:
    factorial = 1;
    i = 1;
    
    while i <= num:
        factorial = factorial * i;
        i = i + 1;
    close
    
    show 'The factorial of ';
    show num;
    show ' is ';
    show factorial;
    show '\n';
close