app_open = true;

while app_open:
    show '\n > Enter a positive integer (or type EXIT to close): ';
    
    val = read;
    t_val = type(val);
    
    is_int = compare(t_val, 'int');
    is_str = compare(t_val, 'str');

    if is_int:
        if val < 0:
            show '\n [X] Error: Factorial of a negative number does not exist.\n';
        else:
            factorial = 1;
            i = 1;
            
            while i <= val:
                factorial = factorial * i;
                i = i + 1;
            close
            
            show '\n  [ SUCCESS ]\n';
            show '  > The factorial of ';
            show val;
            show ' is ';
            show factorial;
            show '\n';
        close
        
    elif is_str:
        is_exit = compare(val, 'EXIT');
        
        if is_exit:
            show '\n Closing Factorial Calculator. Goodbye!\n';
            app_open = false;
        else:
            len_val = length(val);
            if len_val == 0:
                show '\n [X] Error: Input cannot be blank.\n';
            else:
                show '\n [X] Error: Invalid input. Please enter numbers only.\n';
            close
        close
        
    else:
        show '\n [X] Error: Unrecognized input format.\n';
    close
close