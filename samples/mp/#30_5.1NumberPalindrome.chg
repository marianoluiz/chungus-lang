show 'Enter a number: \n';
input_str = read;
num = int(input_str);

original_num = num;
reversed_num = 0;

while num > 0:
    remainder = num % 10;
    reversed_num = (reversed_num * 10) + remainder;
    num = num // 10;
close


if original_num == reversed_num:
    show original_num;
    show ' is a palindrome.\n';
close

if original_num != reversed_num:
    show original_num;
    show ' is not a palindrome.\n';
close