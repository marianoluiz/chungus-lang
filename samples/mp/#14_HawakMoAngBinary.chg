repeat = 1;

while repeat == 1:
    show 'Choose conversion:\n';
    show '1 - Binary to Decimal, Octal, Hexadecimal\n';
    show '2 - Decimal to Binary\n';
    show 'Enter choice: ';
    choice_input = read;
    choice = int(choice_input);

    if choice == 1:
        show 'Enter a binary number: ';
        bin_input = read;
        bin_num = int(bin_input);

        temp = bin_num;
        dec = 0;
        power = 1;
        digit = 0;

        while temp > 0:
            digit = temp % 10;
            dec = dec + (digit * power);
            power = power * 2;
            temp = temp // 10;
        close

        temp_oct = dec;
        oct_val = 0;
        place = 1;
        rem = 0;

        if temp_oct == 0:
            oct_val = 0;
        else:
            while temp_oct > 0:
                rem = temp_oct % 8;
                oct_val = oct_val + (rem * place);
                place = place * 10;
                temp_oct = temp_oct // 8;
            close
        close

        temp_hex = dec;
        hex_digits:[20]=[];
        count = 0;
        hex_digit = '';
        rem_hex = 0;
        idx = 0;
        out_digit = '';

        if temp_hex == 0:
            hex_digits[0] = '0';
            count = 1;
        else:
            while temp_hex > 0:
                rem_hex = temp_hex % 16;

                if rem_hex == 0:
                    hex_digit = '0';
                elif rem_hex == 1:
                    hex_digit = '1';
                elif rem_hex == 2:
                    hex_digit = '2';
                elif rem_hex == 3:
                    hex_digit = '3';
                elif rem_hex == 4:
                    hex_digit = '4';
                elif rem_hex == 5:
                    hex_digit = '5';
                elif rem_hex == 6:
                    hex_digit = '6';
                elif rem_hex == 7:
                    hex_digit = '7';
                elif rem_hex == 8:
                    hex_digit = '8';
                elif rem_hex == 9:
                    hex_digit = '9';
                elif rem_hex == 10:
                    hex_digit = 'A';
                elif rem_hex == 11:
                    hex_digit = 'B';
                elif rem_hex == 12:
                    hex_digit = 'C';
                elif rem_hex == 13:
                    hex_digit = 'D';
                elif rem_hex == 14:
                    hex_digit = 'E';
                else:
                    hex_digit = 'F';
                close

                hex_digits[count] = hex_digit;
                count = count + 1;
                temp_hex = temp_hex // 16;
            close
        close

        show 'Binary: ';
        show bin_input;
        show '\n';

        show 'Decimal: ';
        show dec;
        show '\n';

        show 'Octal: ';
        show oct_val;
        show '\n';

        show 'Hexadecimal: ';
        idx = count - 1;
        while idx >= 0:
            out_digit = hex_digits[idx];
            show out_digit;
            idx = idx - 1;
        close
        show '\n';

    elif choice == 2:
        show 'Enter a decimal number: ';
        dec_input = read;
        dec_num = int(dec_input);

        temp_bin = dec_num;
        bin_result = 0;
        place_bin = 1;
        rem_bin = 0;

        if temp_bin == 0:
            bin_result = 0;
        else:
            while temp_bin > 0:
                rem_bin = temp_bin % 2;
                bin_result = bin_result + (rem_bin * place_bin);
                place_bin = place_bin * 10;
                temp_bin = temp_bin // 2;
            close
        close

        show 'Decimal: ';
        show dec_num;
        show '\n';

        show 'Binary: ';
        show bin_result;
        show '\n';

    else:
        show 'Invalid Input';
        show '\n';
    close

    show 'Do another operation? 1 = Yes, 0 = Exit: ';
    repeat_input = read;
    repeat = int(repeat_input);

    if repeat == 1:
        show '\n';
    elif repeat == 0:
        show 'Program terminated.';
        show '\n';
    else:
        show 'Invalid Input';
        show '\n';
        show 'Program terminated.';
        show '\n';
        repeat = 0;
    close
close