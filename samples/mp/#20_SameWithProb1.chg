fn calcCircle(radius):
    # Area = pi * r^2 (Using 3.14 for pi)
    area = 3.14 * (radius**2);
    ret area;
close

fn calcTriangle(base, height):
    # Area = 1/2base x height 
    area = 0.5 * base * height;
    ret area;
close

fn calcSquare(side):
    # Area = s^2
    area = (side**2);
    ret area;
close

fn calcRectangle(length, width):
    # Area = l * w
    area = length * width;
    ret area;
close

ans = 1; 
while (ans == 1 ): 
show '--- Shape Area Calculator ---';   show '\n'; 
show '1. Circle';    					show '\n'; 
show '2. Triangle';  					show '\n';  
show '3. Square';    					show '\n';  
show '4. Rectangle'; 					show '\n'; 
show 'Enter your choice (1-4): ';


choice = read; 

if (choice == 1):
    show 'Enter radius: ';
    r = read; 
 
    result = calcCircle(r);
    
    
    show 'Area of the Circle is: ';
    show result;

elif (choice == 2):
        show 'Enter base: ';
        b = read; 
        show 'Enter height: ';
        h = read; 
        
        result = calcTriangle(b, h);
        
        show 'Area of the Triangle is: ';
        show result;

    elif (choice == 3):
            show 'Enter side: ';
            s = read; 
            
            result = calcSquare(s);
            
            show 'Area of the Square is: ';
            show result;
        elif (choice == 4):
                show 'Enter length: ';
                l = read; 
                show 'Enter width: ';
                w = read; 
                
                result = calcRectangle(l, w);
                
                show 'Area of the Rectangle is: ';
                show result;

            else:
                # Triggers for any number outside 1-4
                show 'invalid input';
            close 
	
	validInput = false; 
	while (validInput == false):
		show '\n';    
		show 'Press 1 if you want to use the calculator again or 0 to exit'; 
		ans = read;
			if (ans == 1): 
				validInput = true; 
			elif (ans == 0):  
				validInput = true; 
			else: 
				show '\n' ; 
				show 'INVALID INPUT! please type y or n '; 
			close 
		close 
close 

show 'Exiting Program';  