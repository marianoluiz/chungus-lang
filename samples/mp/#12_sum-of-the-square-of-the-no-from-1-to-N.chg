show 'Enter a number N to find the sum of squares from 1 to N: ';
n = read;
n = int(n);

if n < 1:
    show 'Error: N must be a positive integer.';
else:
    sum = 0;
    limit = n + 1;

    for i in range(1, limit):
        squared = i ** 2;
        sum = sum + squared;
    close

    show 'Sum of squares from 1 to N: ';
    show sum;
close