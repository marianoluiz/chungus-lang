show 'Enter number of rows: ';
n_input = read;
n = int(n_input);

if n > 0:
  for i in range(n, 0, ~1):
    spaces = n - i;
    stars = (2 * i) - 1;

    for s in range(spaces):
      show ' ';
    close

    for j in range(stars):
      show '*';
    close

    show '\n';
  close
else:
  show 'Invalid input';
close