fn sum_of_digits(n):
    sum = 0;
    while n > 0:
        digit = n % 10;
        digit = int(digit);
        sum = sum + digit;
        n = n // 10;
        n = int(n);
    close
    ret sum;
close

fn count_trailing_zeros(n):
    count = 0;
    r = n % 10;
    r = int(r);
    while r == 0:
        count = count + 1;
        n = n // 10;
        n = int(n);
        r = n % 10;
        r = int(r);
    close
    ret count;
close

fn reverse_digits(n):
    r = n % 10;
    r = int(r);
    while r == 0:
        n = n // 10;
        n = int(n);
        r = n % 10;
        r = int(r);
    close
    rev = 0;
    while n > 0:
        digit = n % 10;
        digit = int(digit);
        rev = rev * 10 + digit;
        n = n // 10;
        n = int(n);
    close
    ret rev;
close

fn print_zeros(count):
    i = 0;
    while i < count:
        show '0';
        i = i + 1;
    close
    ret 0;
close

show 'REVERSE OF DIGITS\n';
show 'a) Sum of digits  (ex: 156 = 12)\n';
show 'b) Reverse digits (ex: 156 = 651)\n';
show '\nEnter a positive integer: ';
num = read;
num = int(num);

if num < 0:
    show 'Error: Enter a positive number.\n';
elif num == 0:
    show 'Error: Enter a non-zero number.\n';
else:
    sum = sum_of_digits(num);
    zeros = count_trailing_zeros(num);
    zeros = int(zeros);
    rev = reverse_digits(num);
    show '\nInput Number  :';
    show num;
    show '\nSum of Digits :';
    show sum;
    show '\nReversed      :';
    print_zeros(zeros);
    show rev;
    show '\n';
close