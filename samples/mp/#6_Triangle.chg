show 'Enter number of rows: ';
n_input = read;

n = int(n_input);

if n > 0:
  for i in range(1, n + 1):
    stars = (2 * i) - 1;

    for s in range(n - i):
      show ' ';
    close

    for j in range(stars):
      show '*';
    close

    show '\n';
  close
else:
  show 'Invalid input';
close