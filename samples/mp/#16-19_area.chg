fn area_circle(r):
    pi = 3.14159;
    area = pi * r * r;
    ret area;
close

fn area_triangle(b, h):
    area = 0.5 * b * h;
    ret area;
close

fn area_square(s):
    area = s * s;
    ret area;
close

fn area_rectangle(l, w):
    area = l * w;
    ret area;
close

show 'AREA CALCULATOR\n';
show '1 - Area of Circle\n';
show '2 - Area of Triangle\n';
show '3 - Area of Square\n';
show '4 - Area of Rectangle\n';
show '\nEnter your choice: ';
choice = read;
choice = int(choice);

if choice == 1:
    show 'Enter radius: ';
    r = read;
    r = float(r);
    if r < 0:
        show 'Error: Radius cannot be negative.\n';
    else:
        result = area_circle(r);
        show '\nArea of Circle: \n';
        show result;
        show '\n';
    close
elif choice == 2:
    show 'Enter base: ';
    b = read;
    b = float(b);
    if b < 0:
        show 'Error: Base cannot be negative.\n';
    else:
        show 'Enter height: ';
        h = read;
        h = float(h);
        if h < 0:
            show 'Error: Height cannot be negative.\n';
        else:
            result = area_triangle(b, h);
            show '\nArea of Triangle: \n';
            show result;
            show '\n';
        close
    close
elif choice == 3:
    show 'Enter side: ';
    s = read;
    s = float(s);
    if s < 0:
        show 'Error: Side cannot be negative.\n';
    else:
        result = area_square(s);
        show '\nArea of Square: \n';
        show result;
        show '\n';
    close
elif choice == 4:
    show 'Enter length: ';
    l = read;
    l = float(l);
    if l < 0:
        show 'Error: Length cannot be negative.\n';
    else:
        show 'Enter width: ';
        w = read;
        w = float(w);
        if w < 0:
            show 'Error: Width cannot be negative.\n';
        else:
            result = area_rectangle(l, w);
            show '\nArea of Rectangle: \n';
            show result;
            show '\n';
        close
    close
else:
    show 'Error: Invalid Input.\n';
close