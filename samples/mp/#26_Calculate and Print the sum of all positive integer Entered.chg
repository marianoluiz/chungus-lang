sum = 0;
app_open = true;

while app_open:
    show '\n > Enter a positive integer (0 to stop): ';
    
    input_val = read;
    t_val = type(input_val);
    is_int = compare(t_val, 'int');

    if is_int:
        if input_val == 0:
            app_open = false;
        elif input_val < 0:
            show '\n [X] Error: Input must be a positive integer.\n';
        else:
            sum = sum + input_val;
        close
    else:
        is_str = compare(t_val, 'str');
        if is_str:
            len_val = length(input_val);
            if len_val == 0:
                show '\n [X] Error: Input cannot be blank. Please enter a number.\n';
            else:
                show '\n [X] Error: Invalid input. Text is not allowed.\n';
            close
        else:
            show '\n [X] Error: Unrecognized input format.\n';
        close
    close
close

show '\n  [ SUCCESS ]\n';
show '  > The sum of all positive integers is: ';
show sum;
show '\n';
