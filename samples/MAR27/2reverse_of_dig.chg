fn sum_of_digits(n):
    sum = 0;           # declare in outer scope
    if n < 0:
        n = n * ~1;
    close
    while n > 0:
        digit = n % 10;
        sum = sum + digit;
        n = n // 10;
    close
    ret sum;
close

fn count_trailing_zeros(n):
    count = 0;         # declare in outer scope
    if n < 0:
        n = n * ~1;
    close
    if n == 0:
        count = 0;      # 0 should not add extra zero
    else:
        r = n % 10;
        while r == 0:
            count = count + 1;
            n = n // 10;
            r = n % 10;
        close
    close
    ret count;
close

fn reverse_digits(n):
    sign = 1;          # outer scope
    rev = 0;           # outer scope
    if n < 0:
        sign = ~1;
        n = n * ~1;
    close
    if n == 0:
        rev = 0;        # handle 0
    else:
        r = n % 10;
        while r == 0 and n > 0:
            n = n // 10;
            r = n % 10;
        close
        while n > 0:
            digit = n % 10;
            rev = rev * 10 + digit;
            n = n // 10;
        close
    close
    ret rev * sign;
close

fn print_zeros(count):
    i = 0;
    while i < count:
        show '0';
        i = i + 1;
    close
    ret 0;
close

show 'REVERSE OF DIGITS\n';
show 'a) Sum of digits  (ex: 156 = 12)\n';
show 'b) Reverse digits (ex: 156 = 651)\n';
show '\nEnter an integer: ';
num = read;
num = int(num);

# allow zero now
sum = sum_of_digits(num);
zeros = count_trailing_zeros(num);
rev = reverse_digits(num);

show '\nInput Number  : ';
show num;
show '\nSum of Digits : ';
show sum;
show '\nReversed      : ';
if num != 0:
    print_zeros(zeros);
close
show rev;
show '\n';

